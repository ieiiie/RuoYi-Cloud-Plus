<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.ym</groupId>
        <artifactId>ym-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>ym-iot</artifactId>
    <description>物联网业务服务</description>
    <dependencies>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.ym.jetlinks</groupId><artifactId>jetlinks-iot-rpc-api</artifactId><version>2.0.0</version></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-nacos</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-log</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-service-impl</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-doc</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-web</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-mybatis</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-dubbo</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-seata</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-redis</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-tenant</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-security</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-common-excel</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-api-system</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-api-resource</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-api-iot</artifactId></dependency>
        <dependency><groupId>com.ym</groupId><artifactId>ym-api-agriculture</artifactId></dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>com.alibaba.fastjson2</groupId><artifactId>fastjson2</artifactId></dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- IoT 回归使用隔离数据库和模拟 RPC，不按运行环境 dev/prod 标签误过滤。 -->
                    <groups>jetlinks,ownership</groups>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
